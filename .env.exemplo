# Copie este arquivo para ".env" (na mesma pasta do bot_erros.py) e coloque o token do bot.
# Nunca mande o .env para ninguém, nem tire print dele, nem suba para o GitHub.
DISCORD_TOKEN=cole_o_token_aqui

